# Brewstead production environment
# Copy this file to /opt/brewstead/.env on the VPS and fill in real values.
# NEVER commit the real .env file.

# Preferred form
DB_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
DB_USERNAME=USERNAME
DB_PASSWORD=CHANGE_ME

# Spring Boot listens inside the container on 8080.
# PORT is already supplied by docker-compose.yml.
