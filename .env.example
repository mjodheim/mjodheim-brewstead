# Brewstead production environment
# Copy this file to /opt/brewstead/.env on the VPS and fill in the real password.
# NEVER commit the real .env file.

# PostgreSQL hosted by the existing Mira stack on the VPS.
# The Brewstead container joins the external Docker network "mira_internal".
DB_URL=jdbc:postgresql://mira-db:5432/brewstead
DB_USERNAME=brewstead
DB_PASSWORD=CHANGE_ME

# Spring Boot listens inside the container on 8080.
# PORT is already supplied by docker-compose.yml.
