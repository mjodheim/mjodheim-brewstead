FROM eclipse-temurin:26-jdk AS build

WORKDIR /app
COPY . .

# Docker on the VPS has working IPv4 connectivity but no usable IPv6 route.
# Force the Maven Wrapper JVM to prefer IPv4 so Maven downloads do not time out.
RUN chmod +x mvnw \
    && JAVA_TOOL_OPTIONS="-Djava.net.preferIPv4Stack=true" ./mvnw -DskipTests clean package

FROM eclipse-temurin:26-jre

WORKDIR /app
COPY --from=build /app/target/mjodheim-brewstead-0.0.1-SNAPSHOT.jar app.jar

ENV PORT=8080
EXPOSE 8080

CMD ["java", "-jar", "app.jar"]
